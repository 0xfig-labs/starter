    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "5.3.10",
    "@pinia/nuxt": "1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.1",
    "shadcn-nuxt": "^2.8.1",
    "shadcn-vue": "^2.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
