{
  "name": "starter-taro",
  "version": "1.0.0",
  "private": true,
  "description": "taro-template",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "None",
    "framework": "React"
  },
  "scripts": {
    "prepare": "husky",
    "new": "taro new",
    "typecheck": "tsc --noEmit",
